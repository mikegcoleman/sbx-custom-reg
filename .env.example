# Copy this file to .env and fill it in, or export the same variables in your shell.
# A variable that is already set in the environment wins over the value in .env.
# Format: one KEY=value per line. No quotes and no trailing comments.

# Registry host, with a port if it needs one. No scheme (no https://).
REGISTRY=registry.example.com

# Repository path the kits are published under. It may contain slashes and must be
# lowercase. With Artifactory's repository-path access method, start it with the
# Docker repository key, for example docker-local/sbx
REGISTRY_NAMESPACE=sbx

# Credentials with push access (for publishing) and pull access (for developers).
REGISTRY_USERNAME=
REGISTRY_PASSWORD=

# Optional: a PEM file with the CA that signs your registry's certificate. Only needed
# when docker buildx builds fail with "x509: certificate signed by unknown authority".
# REGISTRY_CA_FILE=/path/to/corporate-ca.pem

# Optional: versions. The defaults below are what the repository was written against.
# CLAUDE_KIT_VERSION=2.1.267
# KUBECTL_VERSION=1.32.0
# HELM_VERSION=3.17.0
# K8S_TOOLS_KIT_VERSION=1.0.0
# CLAUDE_K8S_KIT_VERSION=1.0.0
